---


interface Point {
  date: string;
  value: number;
  title?: string;
}
interface Props {
  points: Point[];
  kind?: "line" | "area";
  yMax?: number;
  yFormat?: (n: number) => string;
  label: string;

  color?: "yellow" | "blue";
}
const {
  points,
  kind = "line",
  label,
  color = "yellow",
  yFormat = (n) => Math.round(n).toLocaleString("en-US"),
} = Astro.props;

const W = 800;
const H = 260;
const pad = { top: 16, right: 16, bottom: 40, left: 72 };
const iw = W - pad.left - pad.right;
const ih = H - pad.top - pad.bottom;

const t = (d) => Date.parse(`${d}T00:00:00Z`);
const t0 = t(points[0]?.date);
const t1 = t(points.at(-1)?.date);
const yMax = Astro.props.yMax ?? niceMax(Math.max(1, ...points.map((p) => p.value)));

function niceMax(v) {
  const step = 10 ** Math.floor(Math.log10(v));
  return Math.ceil(v / step) * step;
}
const x = (d) => pad.left + (t1 === t0 ? iw / 2 : ((t(d) - t0) / (t1 - t0)) * iw);
const y = (v) => pad.top + ih - (v / yMax) * ih;

const line = points.map((p, i) => `${i ? "L" : "M"}${x(p.date).toFixed(1)},${y(p.value).toFixed(1)}`).join("");
const area = points.length
  ? `${line}L${x(points.at(-1).date).toFixed(1)},${y(0)}L${x(points[0].date).toFixed(1)},${y(0)}Z`
  : "";

const yTicks = [0, yMax / 2, yMax];


const xTicks = (() => {
  if (!points.length) return [];
  const months = (t1 - t0) / (30.4 * 864e5);
  const every = months > 36 ? 12 : months > 12 ? 3 : 1;
  const ticks = [];
  const d = new Date(t0);
  d.setUTCDate(1);
  d.setUTCMonth(d.getUTCMonth() + 1);
  while (d.getTime() <= t1) {
    if (d.getUTCMonth() % every === 0) ticks.push(d.toISOString().slice(0, 10));
    d.setUTCMonth(d.getUTCMonth() + 1);
  }
  return ticks.length ? ticks : [points[0].date];
})();
const monthLabel = (d) =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });
const showDots = points.length <= 40;
---

<figure class:list={["time-chart", color]}>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
    <g class="grid">
      {
        yTicks.map((v) => (
          <>
            <line x1={pad.left} x2={W - pad.right} y1={y(v)} y2={y(v)} />
            <text x={pad.left - 10} y={y(v)} dy="0.35em" text-anchor="end">
              {yFormat(v)}
            </text>
          </>
        ))
      }
      {
        xTicks.map((d) => (
          <text x={x(d)} y={H - 10} text-anchor="middle">
            {monthLabel(d)}
          </text>
        ))
      }
    </g>
    {kind === "area" && <path class="area" d={area} />}
    <path class="line" d={line} />
    {
      showDots &&
        points.map((p) => (
          <circle class="dot" cx={x(p.date)} cy={y(p.value)} r="4">
            <title>{p.title ?? `${p.date}: ${yFormat(p.value)}`}</title>
          </circle>
        ))
    }
  </svg>
  <slot />
</figure>

<style>
  .time-chart {
    margin: 0;
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .grid line {
    stroke: var(--line);
    stroke-width: 1;
  }
  .grid text {
    fill: var(--muted);
    font-size: 14px;
    font-family: var(--font);
  }
  /* SVG:n skalas ner på smala skärmar; förstora texten så att den förblir läsbar */
  @media (max-width: 600px) {
    .grid text {
      font-size: 28px;
    }
    .line {
      stroke-width: 4;
    }
    .dot {
      r: 6;
    }
  }
  .area {
    fill: rgba(255, 213, 0, 0.16);
  }
  .line {
    fill: none;
    stroke: var(--yellow);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }
  .blue .area {
    fill: rgba(91, 155, 240, 0.16);
  }
  .blue .line {
    stroke: var(--blue);
  }
  .blue .dot {
    fill: var(--blue);
  }
  .dot {
    fill: var(--yellow);
    stroke: var(--bg);
    stroke-width: 2;
  }
</style>
